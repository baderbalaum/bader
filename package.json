{
  "name": "toroz-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only database --project toroz-kiosk \"node test/database.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,database --project toroz-kiosk",
    "dev:emulator": "ng serve -c emulator",
    "build:demo": "ng build -c demo"
  },
  "private": true,
  "packageManager": "npm@11.1.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "firebase": "^12.13.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/leaflet": "^1.9.12",
    "firebase-tools": "^14.24.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
